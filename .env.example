# ── Kompass configuration ─────────────────────────────────────────────
# Copy to `.env` and choose one provider. Ollama needs no API key; OpenAI
# requires OPENAI_API_KEY. The rest have sane local defaults.

# ── Model provider (required) ─────────────────────────────────────────
# ollama = local (default); openai = OpenAI Platform.
KOMPASS_LLM_PROVIDER=ollama

# OpenAI settings (only used when KOMPASS_LLM_PROVIDER=openai).
OPENAI_API_KEY=sk-...

# Model routing (see kompass/models). "provider:model" strings resolved by
# langchain init_chat_model — swap provider by changing these lines only
# (e.g. anthropic:claude-sonnet-5 needs langchain-anthropic installed).
KOMPASS_MODEL_REASONING=openai:gpt-5.5
KOMPASS_MODEL_BALANCED=openai:gpt-5.4
KOMPASS_MODEL_FAST=openai:gpt-5.4-nano

# Ollama settings (only used when KOMPASS_LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
KOMPASS_OLLAMA_MODEL_REASONING=lfm2.5:8b
KOMPASS_OLLAMA_MODEL_BALANCED=lfm2.5:8b
KOMPASS_OLLAMA_MODEL_FAST=lfm2.5:8b

# ── Agent ─────────────────────────────────────────────────────────────
# single = one agent with all tools; multi = supervisor delegates research to a worker agent.
KOMPASS_AGENT_MODE=single
# Per-run token cap (runaway-loop cost backstop).
KOMPASS_TOKEN_BUDGET=200000

# ── Retrieval ─────────────────────────────────────────────────────────
# Local Chroma path; this is the retrieval backend implemented by the project.
KOMPASS_CHROMA_PATH=.chroma
KOMPASS_ACME_DB=corpus/acme.db

# ── Persistence / durable HITL ────────────────────────────────────────
# SQLite is the checkpointer actually wired into the API, demo and eval harness.
KOMPASS_SQLITE_CHECKPOINT=kompass_checkpoints.db

# ── Observability (optional) ──────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local
LANGFUSE_MASK_PII=true
# Ollama costs zero locally. Set current provider prices explicitly for hosted models.
KOMPASS_INPUT_COST_PER_MILLION=0
KOMPASS_OUTPUT_COST_PER_MILLION=0

# ── Serving ───────────────────────────────────────────────────────────
KOMPASS_API_HOST=0.0.0.0
KOMPASS_API_PORT=8000
# Ollama can require several LLM/tool rounds per turn; Streamlit waits this long.
KOMPASS_UI_TIMEOUT_SECONDS=600

# ── A2A (agent-to-agent) ──────────────────────────────────────────────
# Shared secret for HMAC card signing (demo only — prod would use JWS with
# asymmetric keys) and the port the standalone A2A server listens on.
KOMPASS_A2A_SECRET=dev-secret-change-me
KOMPASS_A2A_PORT=8030

# ── Triggers ──────────────────────────────────────────────────────────
# Port the standalone webhook trigger app (kompass/triggers/webhook.py) listens on.
KOMPASS_TRIGGER_PORT=8040
