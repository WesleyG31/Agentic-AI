# Kompass local-development configuration. Copy to .env and fill only values you use.
# Never commit .env. Empty token/secret values intentionally disable those adapters.

# Models
KOMPASS_LLM_PROVIDER=ollama
OPENAI_API_KEY=
KOMPASS_MODEL_REASONING=openai:gpt-5.5
KOMPASS_MODEL_BALANCED=openai:gpt-5.4
KOMPASS_MODEL_FAST=openai:gpt-5.4-nano
OLLAMA_BASE_URL=http://localhost:11434
KOMPASS_OLLAMA_MODEL_REASONING=lfm2.5:8b
KOMPASS_OLLAMA_MODEL_BALANCED=lfm2.5:8b
KOMPASS_OLLAMA_MODEL_FAST=lfm2.5:8b

# Runtime, identity, and bounded autonomy
KOMPASS_ENVIRONMENT=development
KOMPASS_AGENT_MODE=single
KOMPASS_TOKEN_BUDGET=200000
KOMPASS_AUTH_MODE=local
KOMPASS_DEFAULT_TENANT_ID=local
KOMPASS_DEFAULT_TIMEZONE=Europe/Berlin
KOMPASS_DEFAULT_LOCALE=en-US
KOMPASS_OIDC_ISSUER_URL=
KOMPASS_OIDC_AUDIENCE=
KOMPASS_OIDC_DISCOVERY_URL=
KOMPASS_OIDC_JWKS_URL=
KOMPASS_OIDC_TIMEOUT_SECONDS=5
KOMPASS_OIDC_CLOCK_SKEW_SECONDS=30
KOMPASS_MAX_REQUEST_BYTES=64000

# Local business/retrieval data
KOMPASS_CHROMA_PATH=.chroma
KOMPASS_ACME_DB=corpus/acme.db

# Checkpoints, execution control, and transactional actions
KOMPASS_SQLITE_CHECKPOINT=kompass_checkpoints.db
KOMPASS_CHECKPOINT_POSTGRES_DSN=
KOMPASS_DATABASE_URL=
KOMPASS_EXECUTION_STORE_DB=.runtime/executions.db
KOMPASS_EXECUTION_MAX_CONCURRENCY=8
KOMPASS_EXECUTION_QUEUE_CAPACITY=32
KOMPASS_EXECUTION_DEADLINE_SECONDS=120
KOMPASS_EXECUTION_MAX_ATTEMPTS=2
KOMPASS_ACTION_RECEIPTS_DB=.runtime/action_receipts.db
KOMPASS_ACTION_TIMEOUT_SECONDS=30
KOMPASS_ACTION_MAX_ATTEMPTS=2

# Observability. Raw prompt/result export is opt-in; default export is hash/shape only.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local
LANGFUSE_MASK_PII=true
LANGFUSE_CAPTURE_CONTENT=false
KOMPASS_INPUT_COST_PER_MILLION=0
KOMPASS_OUTPUT_COST_PER_MILLION=0

# HTTP/UI
KOMPASS_API_HOST=0.0.0.0
KOMPASS_API_PORT=8000
KOMPASS_UI_TIMEOUT_SECONDS=600

# A2A 1.0. The explicit dev token adapter is local-only; leave blank to disable it.
KOMPASS_A2A_PORT=8030
KOMPASS_A2A_BASE_URL=http://localhost:8030
KOMPASS_A2A_BEARER_TOKEN=
KOMPASS_A2A_DEV_TOKEN=
KOMPASS_A2A_DEV_SUBJECT=local-a2a-client
KOMPASS_A2A_DEV_TENANT=local
KOMPASS_A2A_DEV_SCOPES=research:read
KOMPASS_A2A_TIMEOUT_SECONDS=60
KOMPASS_A2A_MAX_CONCURRENCY=4

# MCP 2.x. Empty remote URL keeps the local stdio transport.
KOMPASS_MCP_REMOTE_URL=
KOMPASS_MCP_BEARER_TOKEN=
KOMPASS_MCP_TIMEOUT_SECONDS=30
KOMPASS_MCP_HTTP_HOST=127.0.0.1
KOMPASS_MCP_HTTP_PORT=8050
KOMPASS_MCP_DEV_TOKEN=
KOMPASS_MCP_DEV_SUBJECT=local-mcp-client
KOMPASS_MCP_DEV_TENANT=local
KOMPASS_MCP_DEV_SCOPES=mcp:invoke documents:read operations:read tickets:read refunds:create tickets:write
KOMPASS_MCP_ISSUER_URL=
KOMPASS_MCP_RESOURCE_URL=

# Event trigger
KOMPASS_TRIGGER_PORT=8040
KOMPASS_TRIGGER_BEARER_TOKEN=
